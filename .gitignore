node_modules/
.tmp/
.tools/
*.log
test-results/
screenshots/

# Local-only compose override (pins a locally-built server image; never commit:
# the tag does not exist on a fresh clone or in CI).
fixtures/.env

# Starling's state directory when a server is started by hand from the repo
# root. Holds the SQLite databases and a generated file-signing key - local
# runtime state, and one `git add .` from being published.
starling-data/

# pnpm's content-addressable store. Nothing in this repo uses pnpm - it is npm
# and package-lock.json throughout - but a stray `pnpm` invocation drops one of
# these in whatever directory it ran from, and an untracked 56 KB tree of
# hashed files is pure noise in `git status` (and one `git add .` from being
# committed).
.pnpm-store/

# A local alias for vendor/server, needed only to build vendor/fancy-plugin-example.
#
# That repo depends on the plugin API by path, as a sibling checkout named
# `mumble-server` (which is the upstream repository's name); ours is the
# `vendor/server` submodule. Rather than patch a pristine checkout, point one at
# the other. Not committed, because it is a filesystem link and not portable:
#
#   Windows:  cmd /c "mklink /J vendor\mumble-server vendor\server"
#   Unix:     ln -s server vendor/mumble-server
#
# Only needed to *rebuild* the example plugins; see
# vendor/starling/crates/plugin-host/host/tests/loads_the_published_examples.rs
vendor/mumble-server

.env