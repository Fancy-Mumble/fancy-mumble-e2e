+    #[gpui::test]
+    fn test_background_follows_aligned_wrapped_lines(cx: &mut TestAppContext) {
+        test_underline_handler_at_scales(cx, |window, cx| {
+            // "abcd", 8 px a glyph, wrapped after "ab", right-aligned in 40 px: each
+            // line is 16 px wide and stands 24 px in from the left.
+            let line = underline_test_line(
+                "abcd",
+                &[DecorationRun {
+                    len: 4,
+                    color: black(),
+                    background_color: Some(hsla(0.5, 0.5, 0.5, 1.)),
+                    underline: None,
+                    strikethrough: None,
+                }],
+                false,
+                window,
+            );
+            let origin = point(px(10.), px(20.));
+            let line_height = px(20.);
+            window.next_frame.scene.clear();
+            paint_line_background(
+                origin,
+                &line.layout,
+                line_height,
+                TextAlign::Right,
+                Some(px(40.)),
+                &line.decoration_runs,
+                &[WrapBoundary {
+                    run_ix: 0,
+                    glyph_ix: 2,
+                }],
+                window,
+                cx,
+            )
+            .unwrap();
+            let scale = window.scale_factor();
+            let painted: Vec<_> = window
+                .next_frame
+                .scene
+                .quads
+                .iter()
+                .map(|quad| quad.bounds)
+                .collect();
+            let expected = [
+                Bounds::new(point(px(34.), px(20.)), size(px(16.), line_height)).scale(scale),
+                Bounds::new(point(px(34.), px(40.)), size(px(16.), line_height)).scale(scale),
+            ];
+            // Quads are snapped to device pixels, so allow a pixel either way.
+            let near = |a: crate::ScaledPixels, b: crate::ScaledPixels| (a.0 - b.0).abs() <= 1.;
+            assert_eq!(painted.len(), expected.len(), "{painted:?}");
+            for (painted, expected) in painted.iter().zip(&expected) {
+                assert!(
+                    near(painted.origin.x, expected.origin.x)
+                        && near(painted.origin.y, expected.origin.y)
+                        && near(painted.size.width, expected.size.width)
+                        && near(painted.size.height, expected.size.height),
+                    "at scale {scale}: painted {painted:?}, expected {expected:?}"
+                );
+            }
+        });
+    }
